{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracefoundry.example/schemas/audit-event.json",
  "title": "audit-event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "example_only": {
      "type": "boolean"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1
        },
        "ledger_sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "previous_event_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "service"
              ]
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "kind",
            "issuer"
          ]
        },
        "producer_sequence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "originating_human_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "payload_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "storage_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "artifact_id",
            "sha256",
            "storage_version"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "denied",
            "started",
            "complete",
            "partial",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "clock_uncertainty_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "ledger_id",
        "ledger_sequence",
        "previous_event_sha256",
        "tenant_id",
        "case_id",
        "run_id",
        "trace_id",
        "parent_event_ids",
        "occurred_at",
        "received_at",
        "producer",
        "producer_sequence",
        "originating_human_id",
        "event_type",
        "decision_id",
        "execution_id",
        "payload_ref",
        "outcome",
        "clock_uncertainty_ms"
      ]
    },
    "hash_algorithm": {
      "const": "SHA-256-RFC8785-TFIR-EVENT-v1"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "example_only",
    "body",
    "hash_algorithm",
    "event_sha256",
    "checkpoint_id"
  ]
}

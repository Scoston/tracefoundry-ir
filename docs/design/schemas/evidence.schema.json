{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracefoundry.example/schemas/evidence.json",
  "title": "evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "example_only": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri",
        "version"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "original_timestamp": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_timezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "collection_request_id": {
          "type": "string",
          "minLength": 1
        },
        "query_ref": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "storage_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "artifact_id",
                "sha256",
                "storage_version"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "system",
        "native_id",
        "original_timestamp",
        "source_timezone",
        "collection_request_id",
        "query_ref"
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collector_identity": {
          "type": "string",
          "minLength": 1
        },
        "authorized_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "failed",
            "unknown"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "collector_identity",
        "authorized_decision_id",
        "acquired_at",
        "receipt_ref",
        "status",
        "gaps"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "storage_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "artifact_id",
              "sha256",
              "storage_version"
            ]
          },
          "minItems": 0
        },
        "transformation_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "parent_refs",
        "transformation_sha256",
        "locator"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "custodian_id": {
          "type": "string",
          "minLength": 1
        },
        "retention_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "retain_until": {
          "type": "string",
          "format": "date-time"
        },
        "hold_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "classification",
        "custodian_id",
        "retention_policy_id",
        "retain_until",
        "hold_ids"
      ]
    },
    "native_integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "not_available",
            "not_checked"
          ]
        },
        "verification_artifact_ref": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "storage_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "artifact_id",
                "sha256",
                "storage_version"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "verification_artifact_ref"
      ]
    }
  },
  "required": [
    "example_only",
    "schema_version",
    "artifact_id",
    "tenant_id",
    "case_id",
    "sha256",
    "byte_length",
    "media_type",
    "storage",
    "source",
    "collection",
    "lineage",
    "governance",
    "native_integrity"
  ]
}

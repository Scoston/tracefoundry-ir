# This file is documentation. The application does not automatically load .env files.
TFIR_DATA_DIR=var
TFIR_ALLOWED_HOSTS=127.0.0.1,localhost
TFIR_SECURE_COOKIES=false
# For a TLS reverse proxy, configure its exact public origin and allowed hostname.
# TFIR_ORIGIN=https://tracefoundry.example.org
# TFIR_SECURE_COOKIES=true
# TFIR_ALLOWED_HOSTS=tracefoundry.example.org

# Optional model disclosure; disabled unless all four settings are configured.
# The endpoint must accept chat-completions JSON with max_tokens and response_format.
# TFIR_MODEL_URL=https://your-approved-provider.example/v1/chat/completions
# TFIR_MODEL_ALLOWED_HOSTS=your-approved-provider.example
# TFIR_MODEL_NAME=your-approved-model
# TFIR_MODEL_API_KEY=inject-through-your-secret-manager
